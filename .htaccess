# www dauerhaft auf die Apex-Domain (Canonical zeigt dorthin, sonst Duplicate Content)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.yourflowstate\.de$ [NC]
  RewriteRule ^(.*)$ https://yourflowstate.de/$1 [R=301,L]
</IfModule>

# FlowState — Cache-Steuerung (IONOS/Apache)
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mp4|webp|svg|jpg|png|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Textkompression (IONOS lieferte CSS/JS bisher unkomprimiert)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

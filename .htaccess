# www dauerhaft auf die Apex-Domain (Canonical zeigt dorthin, sonst Duplicate Content)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.yourflowstate\.de$ [NC]
  RewriteRule ^(.*)$ https://yourflowstate.de/$1 [R=301,L]
</IfModule>

# FlowState — Cache-Steuerung (IONOS/Apache)
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mp4|webp|svg|jpg|png|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Textkompression (IONOS lieferte CSS/JS bisher unkomprimiert)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# Backup- und Quelldateien nie ausliefern
<FilesMatch "\.(bak|old|orig|log|sql)$">
  Require all denied
</FilesMatch>

# Sicherheits-Header
# HSTS bewusst ohne preload und ohne includeSubDomains: preload ist praktisch
# unumkehrbar, und Subdomains sind nicht alle geprueft. Content-Security-Policy
# fehlt hier absichtlich, die braucht einen eigenen Test gegen die Seite.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
